{
  "_doc": "this-expression wire trees and the text both renderers give them: Rust's ThisExpr Display (view-buffer/src/mode.rs) and Python's ThisExpr.__repr__ (python/polars_cv/_this.py). One file, so the two cannot drift.",
  "cases": [
    [["*", ["-", "height", 4], 0.5], "(this.height - 4) * 0.5"],
    [["/", "height", ["+", "width", 1]], "this.height / (this.width + 1)"],
    [["-", "height", ["-", "width", 1]], "this.height - (this.width - 1)"],
    [["+", "height", ["+", "width", 1]], "this.height + this.width + 1"],
    [["-", ["-", "height", "width"], 1], "this.height - this.width - 1"],
    [["*", "height", ["*", "width", 2]], "this.height * this.width * 2"],
    [["/", "height", ["*", "width", 2]], "this.height / (this.width * 2)"],
    [["//", ["+", "height", 1], 2], "(this.height + 1) // 2"],
    [["+", ["*", 0.25, "height"], ["//", "width", 3]], "0.25 * this.height + this.width // 3"],
    [["-", 0, "channels"], "0 - this.channels"],
    [["*", 1.5, "ndim"], "1.5 * this.ndim"]
  ]
}
